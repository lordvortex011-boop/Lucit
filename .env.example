# Frontend (public, safe in browser) — must be set at Vercel *build* time
# (Vite inlines VITE_*). Without these, waitlist always fails.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Edge function only (supabase secrets set / functions secrets set — never VITE_)
# SUPABASE_SERVICE_ROLE_KEY is provided automatically in the edge runtime.
# WAITLIST_NOTIFICATION_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# ALLOWED_ORIGIN=https://lucit.vercel.app
